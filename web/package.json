  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^2.2.12"
  }
}
